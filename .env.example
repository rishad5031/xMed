# =============================================================
# xMED Environment Configuration Example
# Copy this file to .env and configure your local credentials
# =============================================================

# Server Port
PORT=3000

# MySQL / MariaDB Database Configuration (XAMPP or standalone)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=xmed_db

# Google Gemini API Key (Required for MR.MED AI assistant)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for Session Authentication
JWT_SECRET=xmed_production_super_secret_jwt_key_2026
